--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -33,6 +33,7 @@
 #include <net/kpi_interface.h>
 #include <net/kpi_protocol.h>
 #include <netinet/in.h>
+#include <net/route.h>
 #include <net/if_media.h>
 #include <net/dlil.h>
 #include <sys/kern_event.h>
@@ -800,6 +801,23 @@
 		sock_close(so);
 	}
 	ifnet_set_flags(ud.ifp, IFF_UP | IFF_RUNNING, IFF_UP | IFF_RUNNING);
+	/* iOS configd does not manage this interface (the driver sets the
+	 * address directly), so install the default route ourselves;
+	 * otherwise Safari reports "not connected to the Internet" even
+	 * though same-subnet traffic works. */
+	struct sockaddr_in rt_dst, rt_gw;
+	bzero(&rt_dst, sizeof(rt_dst));
+	rt_dst.sin_len = sizeof(rt_dst);
+	rt_dst.sin_family = AF_INET;
+	rt_dst.sin_addr.s_addr = htonl(INADDR_ANY);
+	bzero(&rt_gw, sizeof(rt_gw));
+	rt_gw.sin_len = sizeof(rt_gw);
+	rt_gw.sin_family = AF_INET;
+	rt_gw.sin_addr.s_addr = htonl(0xc0a80701);   /* 192.168.7.1 */
+	int rterr = rtrequest(RTM_ADD, (struct sockaddr *)&rt_dst,
+	    (struct sockaddr *)&rt_gw, NULL, RTF_UP | RTF_GATEWAY, NULL);
+	printf("SWEET USB: default route via 192.168.7.1 %s (err %d)\n",
+	    rterr ? "FAILED" : "added", rterr);
 	printf("SWEET USB: ue0 192.168.7.2/24 %s (err %d)\n", err ? "NOT configured" : "up", err);
 }
 
