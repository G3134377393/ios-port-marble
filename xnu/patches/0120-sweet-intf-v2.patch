--- a/bsd/dev/sweet_glink.c	2026-10-24 12:04:25
+++ b/bsd/dev/sweet_glink.c	2026-10-24 12:04:25
@@ -1500,15 +1500,29 @@
 	(void)g_apm_set_cfg(src_port, G_CDMA_IID, 0x08001018, &v, 4,
 	    "cdma/frame_size");
 
-	/* Interface instance numbering is the last unknown: RX0 is 1 in
-	 * upstream headers, but try 0 as well if the module says no. */
-	for (i = 0; i < 2; i++) {
-		g_put32(intf + 0, 3);                   /* lpaif_type: VA */
-		g_put32(intf + 4, i ? 0 : 1);           /* RX0 */
-		g_put32(intf + 8, 3);                   /* two channels */
-		if (g_apm_set_cfg(src_port, G_CDMA_IID, 0x08001063, intf, 12,
-		    "cdma/intf_cfg") == 0) {
-			break;
+	/* This firmware does not know the upstream CODEC_DMA interface
+	 * parameter (0x08001063); the vendor sends 0x0800101B with a 7-word
+	 * body.  Captured verbatim from the speaker endpoint (module 0x4308):
+	 *   { intf_type 0, intf_index 2, 0x00010001, active 3,
+	 *     0x00200004, 0, 1 }
+	 * Fall back to the upstream form only if it is refused. */
+	{
+		static const uint32_t intf_v2[7] = {
+			0x00000000, 0x00000002, 0x00010001, 0x00000003,
+			0x00200004, 0x00000000, 0x00000001,
+		};
+
+		if (g_apm_set_cfg(src_port, G_CDMA_IID, 0x0800101b, intf_v2,
+		    28, "cdma/intf_v2") != 0) {
+			for (i = 0; i < 2; i++) {
+				g_put32(intf + 0, 3);   /* lpaif_type: VA */
+				g_put32(intf + 4, i ? 0 : 1);
+				g_put32(intf + 8, 3);
+				if (g_apm_set_cfg(src_port, G_CDMA_IID,
+				    0x08001063, intf, 12, "cdma/intf_cfg") == 0) {
+					break;
+				}
+			}
 		}
 	}
 
