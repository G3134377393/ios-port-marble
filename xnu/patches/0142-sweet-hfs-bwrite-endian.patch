 /*
+ * SWEET HFS: decide whether a B-tree node buffer really is in native byte
+ * order before hfs_swap_BTNode(HostToBig) is allowed to convert it back.
+ * The 0x000e heuristic also matches big-endian nodes; swapping a big-endian
+ * node corrupts the catalog ("offset #0 invalid").
- * Intercept B-Tree node writes to unswap them if necessary.
  */
+static int
+hfs_bwrite_node_is_host_order(struct buf *bp)
+{
+	char *dp = (char *)buf_dataptr(bp);
+	size_t n = buf_count(bp);
+	u_int16_t nrec_host, nrec_be;
+	int host_ok, be_ok;
+
+	if (n < 64) {
+		return 0;
+	}
+	memcpy(&nrec_host, dp + 10, sizeof(nrec_host));
+	nrec_be = (u_int16_t)((nrec_host >> 8) | (nrec_host << 8));
+	host_ok = (nrec_host > 0 && nrec_host < 0x2000);
+	be_ok = (nrec_be > 0 && nrec_be < 0x2000);
+	if (host_ok && !be_ok) {
+		return 1;
+	}
+	if (!host_ok && be_ok) {
+		static int warned;
+		if (!warned) {
+			printf("SWEET HFS: bwrite: node is big-endian, not swapping\n");
+			warned = 1;
+		}
+		return 0;
+	}
+	return 1;
+}
