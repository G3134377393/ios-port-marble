 static void
 g_audio_tone(uint32_t src_port, uint32_t dst_port)
 {
+	/* The PCM buffers live inside the mapped region; map it from the
+	 * same client port before the first write. */
+	if (g_apm_shm_map(src_port) != 0 || g_shm_va == 0 || g_shm_pa == 0) {
+		printf("SWEET GLINK: pcm: no shared memory, tone skipped\n");
+		sweet_log_sync();
+		return;
+	}
 	g_fill_tone(G_PCM_OFF_A);
 	g_fill_tone(G_PCM_OFF_B);
 	flush_dcache64((addr64_t)(g_shm_pa + G_PCM_OFF_A), 0x1000, 1);
