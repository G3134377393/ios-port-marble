+/*
+ * SWEET FBDUMP: copy the newest layer surface a SwapEnd named (what
+ * CoreAnimation rendered), not the panel memory.  Returns the byte count
+ * and the surface geometry, or 0 when no usable SwapEnd has been seen.
+ */
+extern "C" uint64_t
+sweet_fb_layer_copy(void *dst, uint64_t capacity, uint32_t *width, uint32_t *height,
+    uint32_t *bpr)
+{
+	AppleCLCD *fb = sweet_fb_instance;
+	SweetSurface *s;
+	uint64_t need, off;
+	uint32_t w, h, b;
+	bool valid;
+
+	if (fb == NULL || dst == NULL) {
+		return 0;
+	}
+	IOLockLock(fb->fLock);
+	s = fb->fLastLayer;
+	valid = fb->fLastLayerValid;
+	off = fb->fLastLayerOff;
+	w = fb->fLastLayerW;
+	h = fb->fLastLayerH;
+	b = fb->fLastLayerBpr;
+	if (s != NULL) {
+		s->retain();
+	}
+	IOLockUnlock(fb->fLock);
+	if (!valid || s == NULL) {
+		OSSafeReleaseNULL(s);
+		return 0;
+	}
+	need = (uint64_t)b * h;
+	uintptr_t src = s->kernelAddress();
+	uint64_t len = s->memory != NULL ? s->memory->getLength() : 0;
+	if (src == 0 || need == 0 || need > capacity || off + need > len) {
+		s->release();
+		return 0;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	memcpy(dst, (const void *)(src + off), (size_t)need);
+	__asm__ volatile("dsb sy" ::: "memory");
+	if (width != NULL) {
+		*width = w;
+	}
+	if (height != NULL) {
+		*height = h;
+	}
+	if (bpr != NULL) {
+		*bpr = b;
+	}
+	s->release();
+	return need;
+}
