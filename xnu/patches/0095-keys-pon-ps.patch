+/* Diagnostic: snapshot the process list (boot-arg sweetps=1). */
+struct keys_ps_ent {
+	int pid, ppid;
+	char stat;
+	unsigned int flag;
+	char comm[17];
+};
+static struct keys_ps_ent keys_ps_buf[192];
+
+static void
+keys_ps_dump(unsigned round)
+{
+	unsigned n = 0;
+	proc_t p;
+
+	proc_list_lock();
+	ALLPROC_FOREACH(p) {
+		if (n >= 192) {
+			break;
+		}
+		struct keys_ps_ent *e = &keys_ps_buf[n++];
+		e->pid = p->p_pid;
+		e->ppid = p->p_ppid;
+		e->stat = p->p_stat;
+		e->flag = p->p_flag;
+		memcpy(e->comm, p->p_comm, sizeof(p->p_comm));
+		e->comm[sizeof(e->comm) - 1] = 0;
+	}
+	proc_list_unlock();
+	printf("SWEET PS: dump %u n=%u\n", round, n);
+	for (unsigned i = 0; i < n; ++i) {
+		printf("SWEET PS: %d %d %c %#x %s\n", keys_ps_buf[i].pid,
+		    keys_ps_buf[i].ppid, keys_ps_buf[i].stat,
+		    keys_ps_buf[i].flag, keys_ps_buf[i].comm);
+	}
+}
+
+static void
+keys_ps_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	for (unsigned i = 0; i < 10; ++i) {
+		keys_wait_ms(30000);
+		keys_ps_dump(i);
+	}
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
