 #include "FileMgrInternal.h"
 #include "BTreesPrivate.h"
 
+/*
+ * SWEET HFS: decide whether a B-tree node buffer already is in native byte
+ * order.
+ *
+ * hfs-627 decides the byte order from the last two bytes of the node (0x0e00
+ * means big-endian, 0x000e means native).  Those bytes are not a byte order
+ * marker: they hold the last entry of the node's record offset table, so a
+ * node whose layout makes them look like 0x0e00 is swapped a second time and
+ * becomes corrupt ("hfs_swap_BTNode: offset #0 invalid").
+ *
+ * The node descriptor's numRecords field (offset +10, u_int16_t) is a far
+ * better hint: it is small in native order and byte-swapped on disk.  Only
+ * record counts below 32 are ambiguous (a byte-swapped small count is also
+ * small), so fall back to the record 0 offset entry, which is 0x000e in
+ * native order and 0x0e00 for a big-endian node.  Nodes that match neither
+ * pattern (zeroed/unused nodes) are treated as native, which is what the old
+ * heuristic did for them.
+ */
+static int
+sweet_hfs_node_is_host_order(char *dp, size_t n)
+{
+	u_int16_t nrec, swapped, last;
+
+	if (dp == NULL || n < sizeof(BTNodeDescriptor)) {
+		return 0;
+	}
+
+	nrec = *(u_int16_t *)((void *)(dp + 10));
+	swapped = (u_int16_t)((nrec >> 8) | (nrec << 8));
+
+	if ((nrec > 0 && nrec < 0x2000) && !(swapped > 0 && swapped < 0x2000)) {
+		return 1;	/* only the native record count makes sense */
+	}
+
+	if (!(nrec > 0 && nrec < 0x2000) && (swapped > 0 && swapped < 0x2000)) {
+		return 0;	/* only the byte-swapped record count makes sense */
+	}
+
+	/* Ambiguous record count: fall back to the record 0 offset entry. */
+	last = *(u_int16_t *)((void *)(dp + n - sizeof (u_int16_t)));
+	return (last == 0x0e00) ? 0 : 1;
+}
+
