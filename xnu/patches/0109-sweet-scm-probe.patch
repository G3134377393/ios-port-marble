+/*
+ * Ask TZ which SCM calls exist (QCOM_SCM_SVC_INFO / IS_CALL_AVAIL).  This is
+ * the same convention probe the Linux qcom_scm driver runs: x0 is the SIP
+ * function id, x1 the arginfo word, x2 the target function id.  No buffers,
+ * no shared memory, no side effects.
+ */
+static void
+au_scm_probe(void)
+{
+	static const struct {
+		const char *name;
+		uint32_t svc;
+		uint32_t cmd;
+	} calls[] = {
+		{ "info.is_call_avail(info)", 0x06, 0x01 },
+		{ "pil.pas_is_supported",     0x02, 0x07 },
+		{ "pil.pas_auth_and_reset",   0x02, 0x05 },
+		{ "pil.pas_shutdown",         0x02, 0x06 },
+	};
+
+	printf("SWEET SCM: probe via smc #0 (fnid base 0xC2000000)\n");
+	for (unsigned i = 0; i < sizeof(calls) / sizeof(calls[0]); i++) {
+		uint64_t r1 = 0, r2 = 0;
+		uint32_t target = 0x02000000u |
+		    ((calls[i].svc & 0xffu) << 8) | (calls[i].cmd & 0xffu);
+		uint32_t ret = au_smc(0x06, 0x01, target, &r1, &r2);
+
+		printf("SWEET SCM: is_call_avail(%s) ret=0x%x r1=0x%llx r2=0x%llx\n",
+		    calls[i].name, ret, (unsigned long long)r1,
+		    (unsigned long long)r2);
+		au_wait(300);
 	}
+	printf("SWEET SCM: probe done\n");
 }
 
