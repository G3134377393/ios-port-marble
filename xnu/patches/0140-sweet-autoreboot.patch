+/*
+ * SWEET AUTO REBOOT: useful while the boot is stuck waiting for a service
+ * that does not exist yet (for example the GPU). Without this the device
+ * sits at the progress bar until an iOS timeout fires an hour later.
+ * Boot-arg: sweetautoreboot=<seconds>
+ */
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+
+static void
+sweet_autoreboot_thread(void *arg, wait_result_t wr)
+{
+	int secs = 0;
+
+	(void)arg;
+	(void)wr;
+	(void)PE_parse_boot_argn("sweetautoreboot", &secs, sizeof(secs));
+	if (secs <= 0) {
+		return;
+	}
+	if (secs > 24 * 3600) {
+		secs = 24 * 3600;
+	}
+	IOLog("SWEET AUTO REBOOT: panic in %d s\n", secs);
+	tsleep(&sweet_autoreboot_thread, PZERO, "swart", (unsigned)secs * hz);
+	panic("SWEET AUTO REBOOT after %d s", secs);
+}
+
+static void
+sweet_autoreboot_start(void)
+{
+	thread_t thread;
+	int secs = 0;
+
+	if (!PE_parse_boot_argn("sweetautoreboot", &secs, sizeof(secs)) || secs <= 0) {
+		return;
+	}
+	if (kernel_thread_start(&sweet_autoreboot_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
