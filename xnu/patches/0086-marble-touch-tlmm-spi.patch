+static void
+mt_rpmh_probe(void)
+{
+	vm_offset_t rsc = ml_io_map(MARBLE_RSC_PA, 0x10000);
+	vm_offset_t tcs = ml_io_map(MARBLE_TCS_PA, 0x3000);
+	if (!rsc || !tcs) {
+		printf("SWEET MARBLE TOUCH: RPMH map failed rsc=%#lx tcs=%#lx\n",
+		    (unsigned long)rsc, (unsigned long)tcs);
+		return;
+	}
+	printf("SWEET MARBLE TOUCH: RPMH read in 2s\n");
+	mt_wait(2000);
+	uint32_t id = mt_rd(rsc, 0);
+	uint32_t cfg = mt_rd(rsc, 0x0c);
+	printf("SWEET MARBLE TOUCH: RPMH id=%#x major=%u minor=%u cfg=%#x tcs_drv2=%u ncpt=%u\n",
+	    id, (id >> 16) & 0xffu, (id >> 8) & 0xffu, cfg,
+	    (cfg >> 12) & 0x3fu, (cfg >> 27) & 0x1fu);
+	for (unsigned t = 0; t < 3; ++t) {
+		uint32_t b = t * 0x2a0u;
+		printf("SWEET MARBLE TOUCH: tcs%u regs:", t);
+		for (unsigned off = 0; off < 0x30; off += 4) {
+			printf(" %#x", mt_rd(tcs, b + off));
+		}
+		printf("\n");
+		mt_wait(500);
+	}
 }
 
 static void
+mt_spi_init(vm_offset_t se)
+{
+	uint32_t fw = mt_rd(se, SE_FW);
+	uint32_t dis = mt_rd(se, SE_IF_DISABLE);
+	printf("SWEET MARBLE TOUCH: SPI init fw=%#x proto=%u if_dis=%#x\n",
+	    fw, (fw >> 8) & 0xffu, dis);
+	mt_wait(1000);
+
+	mt_wr(se, SE_M_CMD_CTRL, 2);      /* abort anything inherited */
+	mt_wr(se, GENI_GSI_EVENT_EN, 0);
+	mt_wr(se, 0x644, 0);
+	mt_wr(se, SE_M_IRQ_EN, M_COMMON_IRQ_EN | M_CMD_DONE);
+	mt_wr(se, GENI_IRQ_EN_TOPBIT, 0);
+	mt_wr(se, GENI_CGC_CTRL, mt_rd(se, GENI_CGC_CTRL) | 0x7fu);
+	mt_wr(se, GENI_DMA_GEN_CFG, mt_rd(se, GENI_DMA_GEN_CFG) | 0x0fu);
+	mt_wr(se, GENI_OUTPUT_CTRL, 0x7fu);
+	mt_wr(se, GENI_FORCE_DEFAULT, 1);
+	mt_wr(se, GENI_DMA_MODE_EN, 0);
+	mt_wr(se, SE_SPI_CPHA, 0);
+	mt_wr(se, SE_SPI_LOOPBACK, 0);
+	mt_wr(se, SE_SPI_CPOL, 0);
+	mt_wr(se, SE_SPI_DEMUX_INV, 0);
+	mt_wr(se, SE_SPI_DEMUX_SEL, 0);
+	mt_wr(se, SE_SPI_TRANS_CFG, mt_rd(se, SE_SPI_TRANS_CFG) & ~SE_SPI_CS_TOGGLE);
+	mt_wr(se, SE_SPI_WORD_LEN, 4);    /* 8-bit words */
+	mt_wr(se, GENI_BYTE_GRAN, 0);
+	mt_wr(se, GENI_TX_PACK_CFG0, 0x0007f8feu);
+	mt_wr(se, GENI_TX_PACK_CFG1, 0x000ffefeu);
+	mt_wr(se, GENI_RX_PACK_CFG0, 0x0007f8feu);
+	mt_wr(se, GENI_RX_PACK_CFG1, 0x000ffefeu);
+	mt_wr(se, SE_M_CLK_CFG, (2u << 4) | 1u);   /* XO/2, ~9.6 MHz */
+	mt_wr(se, SE_CLK_SEL, 0);
+	mt_wr(se, GENI_TX_WM, 0);
+	mt_wr(se, GENI_RX_WM, 13);
+	mt_wr(se, GENI_RX_RFR_WM, 14);
+	mt_wr(se, SE_M_IRQ_CLEAR, 0xffffffffu);
+	mt_wr(se, SE_S_IRQ_CLEAR, 0xffffffffu);
+	mt_wait(1000);
+	printf("SWEET MARBLE TOUCH: SPI init done mclk=%#x word=%#x pack=%#x/%#x/%#x/%#x gran=%#x status=%#x\n",
+	    mt_rd(se, SE_M_CLK_CFG), mt_rd(se, SE_SPI_WORD_LEN),
+	    mt_rd(se, GENI_TX_PACK_CFG0), mt_rd(se, GENI_TX_PACK_CFG1),
+	    mt_rd(se, GENI_RX_PACK_CFG0), mt_rd(se, GENI_RX_PACK_CFG1),
+	    mt_rd(se, GENI_BYTE_GRAN), mt_rd(se, SE_STATUS));
+}
+
+static void
+mt_spi_xfer(vm_offset_t se, const uint8_t *tx, uint8_t *rx, unsigned len,
+    const char *tag)
+{
+	if (len == 0 || len > 64) {
+		return;
+	}
+	for (unsigned i = 0; i < 64 && (mt_rd(se, SE_RX_COUNT) & 0x1ffffffu); ++i) {
+		(void)mt_rd(se, SE_RX_FIFO);
+	}
+	mt_wr(se, GENI_TX_WM, 0);
+	mt_wr(se, SE_SPI_TX_LEN, len);
+	mt_wr(se, SE_SPI_RX_LEN, len);
+	mt_wr(se, SE_M_IRQ_CLEAR, 0xffffffffu);
+	/* Prefill the TX FIFO: 4 SPI bytes per 32-bit FIFO word. */
+	for (unsigned i = 0; i < len; i += 4) {
+		uint32_t word = 0;
+		for (unsigned j = 0; j < 4 && i + j < len; ++j) {
+			word |= (uint32_t)tx[i + j] << (8u * j);
+		}
+		mt_wr(se, SE_TX_FIFO, word);
+	}
+	printf("SWEET MARBLE TOUCH: SPI %s start len=%u txcount=%#x rxcount=%#x status=%#x\n",
+	    tag, len, mt_rd(se, SE_TX_COUNT), mt_rd(se, SE_RX_COUNT),
+	    mt_rd(se, SE_STATUS));
+	mt_wait(500);
+	mt_wr(se, SE_M_CMD0, (3u << 27) | (1u << 2));   /* TX+RX, fragment */
+	uint32_t irq = 0;
+	bool done = false;
+	for (unsigned i = 0; i < 2000; ++i) {
+		irq = mt_rd(se, SE_M_IRQ_STATUS);
+		if (irq & M_CMD_ERRORS) {
+			break;
+		}
+		if (irq & M_CMD_DONE) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	uint32_t count = mt_rd(se, SE_RX_COUNT) & 0x1ffffffu;
+	unsigned got = 0;
+	if (count > 32) {
+		count = 32;
+	}
+	for (unsigned i = 0; i < count; ++i) {
+		uint32_t word = mt_rd(se, SE_RX_FIFO);
+		for (unsigned j = 0; j < 4 && got < len; ++j) {
+			rx[got++] = (uint8_t)(word >> (8u * j));
+		}
+	}
+	printf("SWEET MARBLE TOUCH: SPI %s done=%d irq=%#x rxcount=%u got=%u status=%#x txc=%#x\n",
+	    tag, done ? 1 : 0, irq, count, got, mt_rd(se, SE_STATUS),
+	    mt_rd(se, SE_TX_COUNT));
+	printf("SWEET MARBLE TOUCH: SPI %s rx:", tag);
+	for (unsigned i = 0; i < got; ++i) {
+		printf(" %02x", rx[i]);
+	}
+	printf("\n");
+	mt_wr(se, SE_M_CMD_CTRL, 2);
+	mt_wr(se, SE_M_IRQ_CLEAR, 0xffffffffu);
+	mt_wait(500);
+}
