+static bool
+mt_goodix_read_bra(vm_offset_t se, uint32_t addr, uint8_t *out,
+    unsigned len, const char *tag)
+{
+	uint8_t tx[41] = {0};
+	uint8_t rx[41] = {0};
+	if (len > 32) {
+		return false;
+	}
+	/* Berlin SPI read: F1 + BE32 address + four 0xff bytes, data at +9. */
+	tx[0] = 0xf1;
+	tx[1] = (uint8_t)(addr >> 24);
+	tx[2] = (uint8_t)(addr >> 16);
+	tx[3] = (uint8_t)(addr >> 8);
+	tx[4] = (uint8_t)addr;
+	tx[5] = tx[6] = tx[7] = tx[8] = 0xff;
+	mt_spi_xfer(se, tx, rx, 9u + len, tag);
+	for (unsigned i = 0; i < len; ++i) {
+		out[i] = rx[9u + i];
+	}
+	return true;
+}
