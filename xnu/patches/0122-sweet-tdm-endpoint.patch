+/* Read a pin without changing its configuration: bit 0 of GPIO_IO is the
+ * level actually present on the pad, bit 1 is the value we drive. */
+static int
+sw_gpio_read_level(uint32_t pa)
+{
+	vm_offset_t v = ml_io_map(pa, 0x1000);
+
+	if (!v) {
+		return -1;
+	}
+	return (int)(*(volatile uint32_t *)(v + 4) & 1u);
+}
