+static uint16_t
+au_rd16(vm_offset_t base, uint32_t off)
+{
+	uint16_t v = *(volatile uint16_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
 static void
+au_name(char *dst, const uint32_t *key)
+{
+	unsigned i;
+
+	for (i = 0; i < 8; i++) {
+		char c = (char)((key[i / 4] >> (8u * (i % 4))) & 0xffu);
+		dst[i] = (c >= 0x20 && c < 0x7f) ? c : '.';
+	}
+}
+
+static void
+au_cmddb_dump(void)
+{
+	vm_offset_t db = au_map(CMDDB_PA, CMDDB_SIZE);
+	unsigned total = 0;
+
+	if (db == 0) {
+		return;
+	}
+	printf("SWEET CMDDB: header %08x %08x %08x %08x\n",
+	    au_rd(db, 0), au_rd(db, 4), au_rd(db, 8), au_rd(db, 12));
+	for (unsigned i = 0; i < 8; i++) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = au_rd16(db, h);
+		unsigned count = au_rd16(db, h + 6);
+		unsigned eoff = au_rd16(db, h + 2);
+		unsigned aoff = au_rd16(db, h + 4);
+
+		if (slave == 0xffffu) {
+			continue;
+		}
+		printf("SWEET CMDDB: slave %u entries=%u off=0x%x aux=0x%x count=%u\n",
+		    slave, eoff, eoff, aoff, count);
+		if (count > 256) {
+			printf("SWEET CMDDB: slave %u count %u rejected\n", slave, count);
+			continue;
+		}
+		for (unsigned j = 0; j < count; j++) {
+			uint32_t e = CMDDB_HEADER + eoff + CMDDB_ENTRY * j;
+			uint32_t key[2] = { au_rd(db, e), au_rd(db, e + 4) };
+			char name[9] = { 0 };
+
+			au_name(name, key);
+			printf("SWEET CMDDB: %u:%-14s addr=0x%08x prio=%u:%u aux=%u@%u\n",
+			    slave, name, au_rd(db, e + 16), au_rd(db, e + 8),
+			    au_rd(db, e + 12), au_rd16(db, e + 20), au_rd16(db, e + 22));
+			total++;
+			au_wait(20);
+		}
+	}
+	printf("SWEET CMDDB: %u entries dumped\n", total);
+}
+
+static void
+au_pas_dump(void)
+{
+	vm_offset_t pas = au_map(ADSP_PAS_PA, ADSP_PAS_SIZE);
+
+	if (pas == 0) {
+		return;
+	}
+	for (unsigned off = 0; off < 0x80; off += 0x10) {
+		printf("SWEET PAS: %#04x: %08x %08x %08x %08x\n", off,
+		    au_rd(pas, off), au_rd(pas, off + 4),
+		    au_rd(pas, off + 8), au_rd(pas, off + 12));
+		au_wait(100);
+	}
+}
