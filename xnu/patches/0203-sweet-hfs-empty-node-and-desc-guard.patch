@@ -87,6 +87,31 @@ sweet_hfs_node_is_host_order(char *dp, size_t n)
 	return (last == 0x0e00) ? 0 : 1;
 }
 
+/*
+ * SWEET HFS: true for a zeroed/never-initialized node (an unused node the
+ * B-tree wrote out with BTZeroUnusedNodes, or a freshly allocated block).
+ * Such a node carries no byte order information, so it must not be fed to
+ * hfs_swap_BTNode: with allow_empty_node clear it fails the record offset
+ * check with "offset #0 invalid (0x0000)".
+ */
+static int
+sweet_hfs_node_is_zeroed(char *dp, size_t n)
+{
+	size_t i;
+
+	if (dp == NULL || n < sizeof(BTNodeDescriptor) + sizeof(u_int16_t)) {
+		return 0;
+	}
+
+	for (i = 0; i < sizeof(BTNodeDescriptor); i++) {
+		if (dp[i] != 0) {
+			return 0;
+		}
+	}
+
+	return (dp[n - 2] == 0 && dp[n - 1] == 0);
+}
