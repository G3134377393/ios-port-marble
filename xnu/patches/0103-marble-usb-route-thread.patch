+static int sweet_usb_route_chan;
+
+/*
+ * configd does not manage ue0, so install the default route from a
+ * separate thread AFTER the gadget is running. Doing it inside
+ * ud_if_create() hung the gadget start (a gateway route can send ARP
+ * through ue0 while DWC3 is still in reset). A userland-style
+ * SIOCADDRT from this thread is harmless to the gadget if it fails.
+ */
 static void
+sweet_usb_route_thread(void *arg __unused, wait_result_t result __unused)
+{
+	socket_t so = NULL;
+	struct rtentry rt;
+	struct sockaddr_in dst, gw;
+	uint64_t deadline;
+
+	printf("SWEET USB: route thread start\n");
+	clock_interval_to_deadline(2000, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&sweet_usb_route_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+
+	if (sock_socket(PF_INET, SOCK_DGRAM, 0, NULL, NULL, &so) != 0) {
+		printf("SWEET USB: route thread socket failed\n");
+		goto out;
+	}
+	bzero(&rt, sizeof(rt));
+	bzero(&dst, sizeof(dst));
+	dst.sin_len = sizeof(dst);
+	dst.sin_family = AF_INET;
+	dst.sin_addr.s_addr = htonl(INADDR_ANY);        /* default */
+	bzero(&gw, sizeof(gw));
+	gw.sin_len = sizeof(gw);
+	gw.sin_family = AF_INET;
+	gw.sin_addr.s_addr = htonl(0xc0a80701);         /* 192.168.7.1 */
+	bcopy(&dst, &rt.rt_dst, sizeof(dst));
+	bcopy(&gw, &rt.rt_gateway, sizeof(gw));
+	rt.rt_flags = RTF_UP | RTF_GATEWAY;
+	errno_t err = sock_ioctl(so, SIOCADDRT, &rt);
+	printf("SWEET USB: route thread SIOCADDRT err=%d\n", err);
+	sock_close(so);
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
 sweet_usb_gadget_start(vm_offset_t dwc)
 {
 	thread_t thread;
