+/*
+ * SWEET AUTO REBOOT: optional self-reset timer for stuck-boot testing.
+ * Boot-arg: sweetautoreboot=<seconds>
+ */
+#include <kern/thread.h>
+#include <kern/debug.h>
+#include <sys/kernel.h>
+#include <sys/param.h>
+#include <sys/proc.h>
+#include <pexpert/pexpert.h>
+
+static int sweet_autoreboot_chan;
+
+static void
+sweet_autoreboot_thread(void *arg, wait_result_t wr)
+{
+	int secs = 0;
+
+	(void)arg;
+	(void)wr;
+	(void)PE_parse_boot_argn("sweetautoreboot", &secs, sizeof(secs));
+	if (secs <= 0) {
+		return;
+	}
+	if (secs > 24 * 3600) {
+		secs = 24 * 3600;
+	}
+	IOLog("SWEET AUTO REBOOT: panic in %d s\n", secs);
+	while (secs > 0) {
+		int slice = secs > 10 ? 10 : secs;
+		tsleep(&sweet_autoreboot_chan, PZERO, "swart", (unsigned)slice * 100);
+		secs -= slice;
+	}
+	panic("SWEET AUTO REBOOT after %d s", secs);
+}
+
+static void
+sweet_autoreboot_start(void)
+{
+	thread_t thread;
+	int secs = 0;
+
+	if (!PE_parse_boot_argn("sweetautoreboot", &secs, sizeof(secs)) || secs <= 0) {
+		return;
+	}
+	if (kernel_thread_start(&sweet_autoreboot_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
 #endif /* SWEET */
