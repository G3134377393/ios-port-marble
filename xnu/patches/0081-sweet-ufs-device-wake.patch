--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -387,6 +387,31 @@ ufs_take_over_host(void)
 	return 0;
 }
 
+/*
+ * The bootloader can leave the UFS device powered down.  Its power mode is
+ * selected with START STOP UNIT addressed to the UFS device W-LUN 0xD0
+ * (power condition in cdb[4] bits 7:4, 1 = active).  LUN 0 keeps answering
+ * NOT READY until this has been done, which is what made the first TUR fail.
+ */
+static int
+ufs_device_wake(void)
+{
+	static const uint8_t start[6] = { 0x1B, 0, 0, 0, 0x10, 0 };
+	uint8_t lun = su.lun;
+	int error = 0;
+
+	su.lun = 0xD0;
+	for (int i = 0; i < 3; i++) {
+		error = ufs_scsi(start, sizeof(start), 0, false);
+		if (!error) {
+			break;
+		}
+		delay(100);
+	}
+	su.lun = lun;
+	return error;
+}
+
 static int
 sweet_ufs_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
 {
@@ -623,6 +648,12 @@ sweet_ufs_init(void)
 
 	lck_mtx_lock(&sweet_ufs_lock);
 	error = ufs_take_over_host();
+	if (!error) {
+		int werr = ufs_device_wake();
+		if (werr) {
+			printf("SWEET UFS: device wake failed: %d\n", werr);
+		}
+	}
 	if (!error) {
 		static const uint8_t tur[6] = { 0x00 };
 		/* The first command after the bootloader may report a unit attention. */
