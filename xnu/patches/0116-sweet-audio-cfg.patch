+/* Both amplifier resets are active low; drive them high and give the chips
+ * a few milliseconds before the first address. */
+static void
+sw_gpio_drive_high(uint32_t pa)
+{
+	vm_offset_t v = ml_io_map(pa, 0x1000);
+	uint32_t cfg;
+
+	if (!v) {
+		return;
+	}
+	cfg = *(volatile uint32_t *)v;
+	cfg &= ~0x3ffu;
+	cfg |= (3u << 6) | 0x200u;      /* GPIO function, 8 mA, output */
+	*(volatile uint32_t *)v = cfg;
+	*(volatile uint32_t *)(v + 4) |= 2u;
+}
