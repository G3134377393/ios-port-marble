+static bool
+mt_wait_clear(vm_offset_t base, uint32_t off, uint32_t mask, unsigned ms)
+{
+	for (unsigned i = 0; i < ms; ++i) {
+		if (!(mt_rd(base, off) & mask)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static bool
+mt_clocks(vm_offset_t gcc)
+{
+	uint32_t cmd, cfg, m, n, d, dfs, vote;
+
+	printf("SWEET MARBLE TOUCH: GCC read in 2s\n");
+	mt_wait(2000);
+	vote = mt_rd(gcc, GCC_QUPV3_VOTE);
+	printf("SWEET MARBLE TOUCH: gcc vote=%#x core_halt=%#x se4_halt=%#x\n",
+	    vote, mt_rd(gcc, GCC_WRAP0_CORE_HALT), mt_rd(gcc, GCC_SE4_HALT));
+
+	cmd = mt_rd(gcc, GCC_SE4_RCG + RCG_CMD);
+	cfg = mt_rd(gcc, GCC_SE4_RCG + RCG_CFG);
+	m = mt_rd(gcc, GCC_SE4_RCG + RCG_M);
+	n = mt_rd(gcc, GCC_SE4_RCG + RCG_N);
+	d = mt_rd(gcc, GCC_SE4_RCG + RCG_D);
+	dfs = mt_rd(gcc, GCC_SE4_RCG + RCG_DFS_EN);
+	printf("SWEET MARBLE TOUCH: se4 rcg cmd=%#x cfg=%#x m=%#x n=%#x d=%#x dfs=%#x\n",
+	    cmd, cfg, m, n, d, dfs);
+
+	if (dfs & 1u) {
+		/* Leave the DFS table alone; it already owns the RCG. */
+		printf("SWEET MARBLE TOUCH: se4 RCG is DFS-owned; not rewriting\n");
+	} else if ((cfg & RCG_CFG_MASK) == 1u && m == 0 && n == 0 && d == 0) {
+		printf("SWEET MARBLE TOUCH: se4 RCG already XO/1\n");
+	} else {
+		printf("SWEET MARBLE TOUCH: setting se4 RCG to XO/1\n");
+		mt_wr(gcc, GCC_SE4_RCG + RCG_M, 0);
+		mt_wr(gcc, GCC_SE4_RCG + RCG_N, 0);
+		mt_wr(gcc, GCC_SE4_RCG + RCG_D, 0);
+		mt_wr(gcc, GCC_SE4_RCG + RCG_CFG, (cfg & ~RCG_CFG_MASK) | 1u);
+		mt_wr(gcc, GCC_SE4_RCG + RCG_CMD, cmd | 1u);
+		if (!mt_wait_clear(gcc, GCC_SE4_RCG + RCG_CMD, 1u, 1000)) {
+			printf("SWEET MARBLE TOUCH: se4 RCG update timeout cmd=%#x\n",
+			    mt_rd(gcc, GCC_SE4_RCG + RCG_CMD));
+			return false;
+		}
+		printf("SWEET MARBLE TOUCH: se4 RCG now cmd=%#x cfg=%#x m=%#x n=%#x d=%#x\n",
+		    mt_rd(gcc, GCC_SE4_RCG + RCG_CMD),
+		    mt_rd(gcc, GCC_SE4_RCG + RCG_CFG),
+		    mt_rd(gcc, GCC_SE4_RCG + RCG_M),
+		    mt_rd(gcc, GCC_SE4_RCG + RCG_N),
+		    mt_rd(gcc, GCC_SE4_RCG + RCG_D));
+	}
+
+	printf("SWEET MARBLE TOUCH: voting QUP0 core/m-ahb/s-ahb/se4\n");
+	mt_wr(gcc, GCC_QUPV3_VOTE, vote | GCC_VOTE_MASK);
+	mt_wait(2000);
+	printf("SWEET MARBLE TOUCH: gcc vote=%#x (mask %#x)\n",
+	    mt_rd(gcc, GCC_QUPV3_VOTE), GCC_VOTE_MASK);
+
+	const uint32_t halts[] = {
+		GCC_WRAP0_CORE_HALT, GCC_WRAP0_CORE_2X_HALT,
+		GCC_WRAP0_M_AHB_HALT, GCC_WRAP0_S_AHB_HALT, GCC_SE4_HALT,
+	};
+	bool ok = true;
+	for (unsigned i = 0; i < sizeof(halts) / sizeof(halts[0]); ++i) {
+		bool clear = mt_wait_clear(gcc, halts[i], 1u << 31, 1000);
+		printf("SWEET MARBLE TOUCH: halt %#x %s value=%#x\n", halts[i],
+		    clear ? "clear" : "TIMEOUT", mt_rd(gcc, halts[i]));
+		ok &= clear;
+	}
+	return ok;
+}
+
 static void
+mt_se_report(vm_offset_t se, const char *when)
+{
+	uint32_t fw, status, dis, hw0, hw1, txc, rxc, ios, clk, mcfg;
+
+	printf("SWEET MARBLE TOUCH: SE %s read in 2s\n", when);
+	mt_wait(2000);
+	fw = mt_rd(se, SE_FW);
+	printf("SWEET MARBLE TOUCH: SE %s fw=%#x protocol=%u revision=%u\n",
+	    when, fw, (fw >> 8) & 0xffu, fw & 0xffu);
+	status = mt_rd(se, SE_STATUS);
+	dis = mt_rd(se, SE_IF_DISABLE);
+	hw0 = mt_rd(se, SE_HW_TX);
+	hw1 = mt_rd(se, SE_HW_RX);
+	txc = mt_rd(se, SE_TX_COUNT);
+	rxc = mt_rd(se, SE_RX_COUNT);
+	ios = mt_rd(se, SE_IOS);
+	clk = mt_rd(se, SE_CLK_SEL);
+	mcfg = mt_rd(se, SE_M_CLK_CFG);
+	printf("SWEET MARBLE TOUCH: SE %s status=%#x if_dis=%#x hwtx=%#x hwrx=%#x\n",
+	    when, status, dis, hw0, hw1);
+	printf("SWEET MARBLE TOUCH: SE %s tx_count=%#x rx_count=%#x ios=%#x clk_sel=%#x m_clk_cfg=%#x\n",
+	    when, txc, rxc, ios, clk, mcfg);
+	printf("SWEET MARBLE TOUCH: SE %s irq=%#x\n", when,
+	    mt_rd(se, SE_M_IRQ_STATUS));
+}
+
+static void
+mt_gpio(vm_offset_t gpio, unsigned pin, unsigned mux, unsigned pull,
+    unsigned drive, bool out, bool high)
+{
+	uint32_t cfg = mt_rd(gpio, GPIO_CFG(pin));
+	if (out) {
+		uint32_t io = mt_rd(gpio, GPIO_IO(pin));
+		io = high ? (io | 2u) : (io & ~2u);
+		mt_wr(gpio, GPIO_IO(pin), io);
+	}
+	cfg &= ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	mt_wr(gpio, GPIO_CFG(pin), cfg);
+}
+
+static void
+mt_pins(vm_offset_t gpio)
+{
+	printf("SWEET MARBLE TOUCH: TLMM read in 2s\n");
+	mt_wait(2000);
+	for (unsigned pin = 16; pin <= 21; ++pin) {
+		printf("SWEET MARBLE TOUCH: gpio%u cfg=%#x io=%#x\n", pin,
+		    mt_rd(gpio, GPIO_CFG(pin)), mt_rd(gpio, GPIO_IO(pin)));
+	}
+
+	/* SE4 SPI: pins 16..19, function index 1 (qup4 on this pingroup). */
+	for (unsigned pin = 16; pin <= 19; ++pin) {
+		mt_gpio(gpio, pin, 1, 0, 2, false, false);
+	}
+	printf("SWEET MARBLE TOUCH: spi pins cfg16..19=%#x/%#x/%#x/%#x\n",
+	    mt_rd(gpio, GPIO_CFG(16)), mt_rd(gpio, GPIO_CFG(17)),
+	    mt_rd(gpio, GPIO_CFG(18)), mt_rd(gpio, GPIO_CFG(19)));
+
+	/* GPIO20 reset (active low), GPIO21 IRQ input, both pull-up. */
+	mt_gpio(gpio, 20, 0, 3, 3, true, false);
+	mt_gpio(gpio, 21, 0, 3, 3, false, false);
+	mt_wait(5);
+	mt_gpio(gpio, 20, 0, 3, 3, true, true);
+	mt_wait(100);
+	printf("SWEET MARBLE TOUCH: gpio20 cfg=%#x io=%#x gpio21 cfg=%#x io=%#x\n",
+	    mt_rd(gpio, GPIO_CFG(20)), mt_rd(gpio, GPIO_IO(20)),
+	    mt_rd(gpio, GPIO_CFG(21)), mt_rd(gpio, GPIO_IO(21)));
+}
