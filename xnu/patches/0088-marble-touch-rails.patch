+	mt_wait(10);
+	mt_gpio(gpio, 20, 0, 3, 3, true, true);
+	mt_wait(100);
+	printf("SWEET MARBLE TOUCH: IC reset done gpio20=%#x gpio21=%#x\n",
+	    mt_rd(gpio, GPIO_IO(20)), mt_rd(gpio, GPIO_IO(21)));
 }
 
