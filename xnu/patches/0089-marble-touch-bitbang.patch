+static uint8_t
+bb_byte(vm_offset_t gpio, unsigned clk, unsigned mosi, unsigned miso,
+    uint8_t out)
+{
+	uint8_t in = 0;
+	for (int bit = 7; bit >= 0; --bit) {
+		bb_io(gpio, mosi, (out >> bit) & 1u);
+		bb_io(gpio, clk, false);
+		bb_delay();
+		bb_io(gpio, clk, true);
+		bb_delay();
+		in = (uint8_t)((in << 1) | (mt_rd(gpio, GPIO_IO(miso)) & 1u));
+		bb_io(gpio, clk, false);
+		bb_delay();
+	}
+	return in;
 }
 
