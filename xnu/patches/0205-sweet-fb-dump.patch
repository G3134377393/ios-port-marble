 }
 
+/*
+ * SWEET FBDUMP: copy the current panel frame out for the kernel frame buffer
+ * dump thread (bsd/dev/sweet_ufs.c).  The copy is taken through the same
+ * mapping the driver's presents write through, so it sees exactly what is on
+ * the panel; a barrier makes sure in-flight writes have drained first.
+ * Returns the byte count, or 0 when there is no boot framebuffer (yet).
+ */
+extern "C" uint64_t
+sweet_fb_frame_copy(void *dst, uint64_t capacity, uint32_t *width, uint32_t *height,
+    uint32_t *stride)
+{
+	AppleCLCD *fb = sweet_fb_instance;
+	uint64_t need;
+
+	if (fb == NULL || fb->fPixels == 0 || dst == NULL ||
+	    fb->fWidth == 0 || fb->fHeight == 0 || fb->fRowBytes < fb->fWidth * 4) {
+		return 0;
+	}
+	need = (uint64_t)fb->fRowBytes * (uint64_t)fb->fHeight;
+	if (need > capacity) {
+		return 0;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	memcpy(dst, (const void *)fb->fPixels, (size_t)need);
+	__asm__ volatile("dsb sy" ::: "memory");
+	if (width != NULL) {
+		*width = fb->fWidth;
+	}
+	if (height != NULL) {
+		*height = fb->fHeight;
+	}
+	if (stride != NULL) {
+		*stride = fb->fRowBytes;
+	}
+	return need;
+}
