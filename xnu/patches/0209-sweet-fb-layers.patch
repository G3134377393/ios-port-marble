 {
@@ -411,6 +475,44 @@ AppleCLCD::swap(const uint8_t *rec)
 	if ((++sweet_fb_swap_count % 1000) == 0) {
 		IOLog("SWEET FB: %llu swaps\n", sweet_fb_swap_count);
 	}
+
+	/*
+	 * SWEET FBDUMP: keep the newest surface this SwapEnd named so the frame
+	 * buffer dump thread can save what CoreAnimation actually rendered,
+	 * independently of whether present() manages to composite it.
+	 */
+	uint32_t mask = get32(rec, 0x104);
+	for (uint32_t layer = SWEET_FB_LAYERS; layer > 0; layer--) {
+		uint32_t id = get32(rec, 0x54 + 4 * (layer - 1));
+		if (!(mask & (1u << (layer - 1))) || id == 0) {
+			continue;
+		}
+		SweetSurface *s = sweet_surface_copy(id);
+		if (s == NULL || s == fSurface) {
+			OSSafeReleaseNULL(s);
+			continue;
+		}
+		uintptr_t src = s->kernelAddress();
+		uint64_t need = (uint64_t)s->bytesPerRow * s->height;
+		if (src == 0 || need == 0 ||
+		    (uint64_t)s->offset + need > s->memory->getLength()) {
+			OSSafeReleaseNULL(s);
+			continue;
+		}
+		IOLockLock(fLock);
+		SweetSurface *old = fLastLayer;
+		fLastLayer = s;                 /* our reference moves to fLastLayer */
+		fLastLayerOff = s->offset;
+		fLastLayerW = s->width;
+		fLastLayerH = s->height;
+		fLastLayerBpr = s->bytesPerRow;
+		fLastLayerValid = true;
+		IOLockUnlock(fLock);
+		if (old != NULL) {
+			old->release();
+		}
+		break;
+	}
