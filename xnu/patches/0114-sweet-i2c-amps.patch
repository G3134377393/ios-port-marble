@@ -0,0 +1,323 @@
+/*
+ * SWEET: bit-banged I2C for the two AW882xx speaker amplifiers.
+ *
+ * Marble puts them on i2c@880000 (qup15), SCL=GPIO56 / SDA=GPIO57.  The
+ * TLMM register block is at 0x0f100000: the DT node pinctrl@f000000 starts
+ * one megabyte earlier, but the pin registers themselves are not there
+ * (patch 0086 hit the same wall with the touch controller).  The two pins
+ * therefore live at 0x0f138000 and 0x0f139000, so map only those pages.
+ *
+ * A GENI SE driver would be far more code than bring-up needs: read the chip
+ * id, then write the vendor ACF's Music profile.  Bit-banging at ~250 kHz
+ * is plenty.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+#define SW_I2C_TLMM_PA  0x0f138000u     /* pinctrl@f000000 + 56*0x1000 */
+#define SW_I2C_TLMM_SZ  0x2000u
+#define SW_I2C_SCL      0u
+#define SW_I2C_SDA      1u
+
+#define SW_GPIO_CFG(n)   ((uint32_t)(n) * 0x1000u)
+#define SW_GPIO_IO(n)    (SW_GPIO_CFG(n) + 4u)
+
+static vm_offset_t sw_i2c_gpio;
+static uint32_t sw_scl_cfg_saved, sw_sda_cfg_saved;
+static int sw_i2c_ok;
+
+static uint32_t
+sw_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(sw_i2c_gpio + off);
+}
+
+static void
+sw_wr(uint32_t off, uint32_t val)
+{
+	*(volatile uint32_t *)(sw_i2c_gpio + off) = val;
+}
+
+/* pull: 0 none, 3 pull-up (same encoding sweet_touch.c uses). */
+static void
+sw_gpio_cfg(unsigned pin, uint32_t pull, bool out)
+{
+	uint32_t off = SW_GPIO_CFG(pin);
+	uint32_t cfg = sw_rd(off);
+
+	cfg &= ~0x3ffu;
+	cfg |= (0u << 2) | pull | (3u << 6) | (out ? 0x200u : 0u);
+	sw_wr(off, cfg);
+}
+
+static void
+sw_scl(bool high)
+{
+	uint32_t off = SW_GPIO_IO(SW_I2C_SCL);
+	uint32_t v = sw_rd(off);
+
+	sw_wr(off, high ? (v | 2u) : (v & ~2u));
+}
+
+static void
+sw_sda(bool high)
+{
+	uint32_t off = SW_GPIO_IO(SW_I2C_SDA);
+
+	if (high) {
+		/* open-drain high: let the external pull-up do the work */
+		sw_wr(off, sw_rd(off) | 2u);
+		sw_gpio_cfg(SW_I2C_SDA, 3, false);
+	} else {
+		sw_wr(off, sw_rd(off) & ~2u);
+		sw_gpio_cfg(SW_I2C_SDA, 0, true);
+	}
+}
+
+static int
+sw_sda_read(void)
+{
+	return (int)(sw_rd(SW_GPIO_IO(SW_I2C_SDA)) & 1u);
+}
+
+static void
+sw_i2c_delay(void)
+{
+	delay(2);       /* ~2 us per half period -> ~250 kHz */
+}
+
+static void
+sw_i2c_start(void)
+{
+	sw_sda(1);
+	sw_scl(1);
+	sw_i2c_delay();
+	sw_sda(0);
+	sw_i2c_delay();
+	sw_scl(0);
+	sw_i2c_delay();
+}
+
+static void
+sw_i2c_stop(void)
+{
+	sw_sda(0);
+	sw_i2c_delay();
+	sw_scl(1);
+	sw_i2c_delay();
+	sw_sda(1);
+	sw_i2c_delay();
+}
+
+static int
+sw_i2c_write_byte(uint8_t b)
+{
+	int ack;
+
+	for (int i = 7; i >= 0; i--) {
+		sw_sda((b >> i) & 1);
+		sw_i2c_delay();
+		sw_scl(1);
+		sw_i2c_delay();
+		sw_scl(0);
+		sw_i2c_delay();
+	}
+	sw_sda(1);
+	sw_i2c_delay();
+	sw_scl(1);
+	sw_i2c_delay();
+	ack = sw_sda_read() == 0;
+	sw_scl(0);
+	sw_i2c_delay();
+	return ack;
+}
+
+static uint8_t
+sw_i2c_read_byte(int ack)
+{
+	uint8_t v = 0;
+
+	sw_sda(1);
+	for (int i = 7; i >= 0; i--) {
+		sw_i2c_delay();
+		sw_scl(1);
+		sw_i2c_delay();
+		v = (uint8_t)((v << 1) | (uint32_t)sw_sda_read());
+		sw_scl(0);
+		sw_i2c_delay();
+	}
+	if (ack) {
+		sw_sda(0);
+	} else {
+		sw_sda(1);
+	}
+	sw_i2c_delay();
+	sw_scl(1);
+	sw_i2c_delay();
+	sw_scl(0);
+	sw_i2c_delay();
+	sw_sda(1);
+	return v;
+}
+
+/* AW882xx: 8-bit register address, 16-bit data, high byte first. */
+static int
+sw_aw_read(uint8_t addr, uint8_t reg, uint16_t *out)
+{
+	uint8_t hi, lo;
+
+	sw_i2c_start();
+	if (!sw_i2c_write_byte((uint8_t)(addr << 1))) {
+		sw_i2c_stop();
+		return -1;
+	}
+	if (!sw_i2c_write_byte(reg)) {
+		sw_i2c_stop();
+		return -1;
+	}
+	sw_i2c_start();
+	if (!sw_i2c_write_byte((uint8_t)((addr << 1) | 1))) {
+		sw_i2c_stop();
+		return -1;
+	}
+	hi = sw_i2c_read_byte(1);
+	lo = sw_i2c_read_byte(0);
+	sw_i2c_stop();
+	*out = ((uint16_t)hi << 8) | lo;
+	return 0;
+}
+
+static int
+sw_aw_write(uint8_t addr, uint8_t reg, uint16_t val)
+{
+	sw_i2c_start();
+	if (!sw_i2c_write_byte((uint8_t)(addr << 1)) ||
+	    !sw_i2c_write_byte(reg) ||
+	    !sw_i2c_write_byte((uint8_t)(val >> 8)) ||
+	    !sw_i2c_write_byte((uint8_t)(val & 0xff))) {
+		sw_i2c_stop();
+		return -1;
+	}
+	sw_i2c_stop();
+	return 0;
+}
+
+static void
+sw_i2c_pins_up(void)
+{
+	sw_scl_cfg_saved = sw_rd(SW_GPIO_CFG(SW_I2C_SCL));
+	sw_sda_cfg_saved = sw_rd(SW_GPIO_CFG(SW_I2C_SDA));
+	sw_gpio_cfg(SW_I2C_SCL, 3, true);
+	sw_wr(SW_GPIO_IO(SW_I2C_SCL), sw_rd(SW_GPIO_IO(SW_I2C_SCL)) | 2u);
+	sw_sda(1);
+}
+
+static void
+sw_i2c_pins_down(void)
+{
+	sw_wr(SW_GPIO_CFG(SW_I2C_SCL), sw_scl_cfg_saved);
+	sw_wr(SW_GPIO_CFG(SW_I2C_SDA), sw_sda_cfg_saved);
+}
+
+/* Music profile register table from the vendor's ACF (dde1 @0x410).
+ * 0x04 SYSCTRL differs between the two Music profiles only in bit 15;
+ * table A is the one with ULS_MODE set. */
+static const struct {
+	uint8_t reg;
+	uint16_t val;
+} aw882xx_music_a[44] = {
+	{ 0x03, 0xffff }, { 0x04, 0xb440 }, { 0x05, 0x05a9 }, { 0x06, 0x94e9 },
+	{ 0x07, 0x007d }, { 0x08, 0x2168 }, { 0x09, 0x3940 }, { 0x0a, 0x0030 },
+	{ 0x0b, 0x01e0 }, { 0x0c, 0x0064 }, { 0x0d, 0xa05b }, { 0x0e, 0x2392 },
+	{ 0x0f, 0xee80 }, { 0x15, 0x9838 }, { 0x20, 0x2001 }, { 0x30, 0x460c },
+	{ 0x31, 0xc989 }, { 0x32, 0x3541 }, { 0x33, 0x4db8 }, { 0x34, 0xd6f9 },
+	{ 0x35, 0x7ace }, { 0x36, 0xec7c }, { 0x37, 0x000c }, { 0x38, 0x0030 },
+	{ 0x50, 0x0080 }, { 0x52, 0x20c4 }, { 0x53, 0x0010 }, { 0x54, 0x0000 },
+	{ 0x55, 0x00d8 }, { 0x59, 0x000c }, { 0x5a, 0xc103 }, { 0x60, 0x0c0b },
+	{ 0x61, 0x6979 }, { 0x62, 0x04c1 }, { 0x63, 0x260f }, { 0x64, 0x15c3 },
+	{ 0x65, 0x8d05 }, { 0x66, 0x7f07 }, { 0x67, 0x0002 }, { 0x68, 0x3002 },
+	{ 0x69, 0x04a0 }, { 0x6a, 0xa068 }, { 0x6b, 0x8884 }, { 0x6c, 0x1000 },
+};
+
+/* Soft reset, then the vendor's Music profile. */
+static int
+sw_aw_init(uint8_t addr)
+{
+	int err = 0;
+
+	if (sw_aw_write(addr, 0x00, 0x55aa) != 0) {
+		return -1;
+	}
+	delay(2);
+	for (unsigned i = 0; i < sizeof(aw882xx_music_a) /
+	    sizeof(aw882xx_music_a[0]); i++) {
+		if (sw_aw_write(addr, aw882xx_music_a[i].reg,
+		    aw882xx_music_a[i].val) != 0) {
+			err++;
+		}
+	}
+	return err ? -1 : 0;
+}
+
+void sweet_i2c_probe_amps(void);
+
+void
+sweet_i2c_probe_amps(void)
+{
+	static const uint8_t addrs[2] = { 0x34, 0x35 };
+	int on = 1, amp_on = 1;
+	uint32_t cfg_scl, cfg_sda;
+
+	(void)PE_parse_boot_argn("sweeti2c", &on, sizeof(on));
+	(void)PE_parse_boot_argn("sweetamp", &amp_on, sizeof(amp_on));
+	if (!on) {
+		printf("SWEET I2C: disabled (sweeti2c=0)\n");
+		return;
+	}
+
+	sw_i2c_gpio = ml_io_map(SW_I2C_TLMM_PA, SW_I2C_TLMM_SZ);
+	if (!sw_i2c_gpio) {
+		printf("SWEET I2C: no TLMM mapping\n");
+		return;
+	}
+	cfg_scl = sw_rd(SW_GPIO_CFG(SW_I2C_SCL));
+	cfg_sda = sw_rd(SW_GPIO_CFG(SW_I2C_SDA));
+	printf("SWEET I2C: TLMM @%#x scl cfg=%#x sda cfg=%#x\n",
+	    SW_I2C_TLMM_PA, cfg_scl, cfg_sda);
+
+	sw_i2c_pins_up();
+	printf("SWEET I2C: bus idle, sda=%d\n", sw_sda_read());
+
+	for (int i = 0; i < 2; i++) {
+		uint16_t id = 0, sysst = 0, sysctrl = 0;
+
+		if (sw_aw_read(addrs[i], 0x00, &id) != 0) {
+			printf("SWEET I2C: amp %#x no ack\n", addrs[i]);
+			continue;
+		}
+		(void)sw_aw_read(addrs[i], 0x01, &sysst);
+		(void)sw_aw_read(addrs[i], 0x04, &sysctrl);
+		printf("SWEET I2C: amp %#x id=%#x sysst=%#x sysctrl=%#x\n",
+		    addrs[i], id, sysst, sysctrl);
+		if (id == 0x2032) {
+			sw_i2c_ok++;
+			if (amp_on) {
+				int rc = sw_aw_init(addrs[i]);
+
+				printf("SWEET I2C: amp %#x init %s\n",
+				    addrs[i], rc == 0 ? "ok" : "FAILED");
+			}
+		}
+	}
+
+	sw_i2c_pins_down();
+	printf("SWEET I2C: %d amplifier(s) answered 0x2032\n", sw_i2c_ok);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
