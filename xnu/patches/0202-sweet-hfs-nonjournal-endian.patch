+/*
+ * SWEET HFS: decide whether a B-tree node buffer still is in native byte
+ * order and therefore has to be converted before it is written out.
+ *
+ * The old 0x000e test (the last two bytes are the record 0 offset entry) also
+ * matches nodes that already are big-endian.  Use the node descriptor's
+ * numRecords field (offset +10) instead; for the small counts where both
+ * readings look valid, fall back to the record 0 offset entry.  A node that
+ * matches neither pattern (zeroed/unused node) is left alone as before:
+ * hfs_swap_BTNode would reject it with allow_empty_node set to false.
+ */
+static int
+hfs_bwrite_node_is_host_order(struct buf *bp)
+{
+	char *dp = (char *)buf_dataptr(bp);
+	size_t n = buf_count(bp);
+	u_int16_t nrec, swapped, last;
+
+	if (dp == NULL || n < sizeof(BTNodeDescriptor)) {
+		return 0;
+	}
+
+	nrec = *(u_int16_t *)((void *)(dp + 10));
+	swapped = (u_int16_t)((nrec >> 8) | (nrec << 8));
+
+	if ((nrec > 0 && nrec < 0x2000) && !(swapped > 0 && swapped < 0x2000)) {
+		return 1;	/* only the native record count makes sense */
+	}
+
+	if (!(nrec > 0 && nrec < 0x2000) && (swapped > 0 && swapped < 0x2000)) {
+		return 0;	/* only the byte-swapped record count makes sense */
+	}
+
+	/* Ambiguous record count: fall back to the record 0 offset entry. */
+	last = *(u_int16_t *)((void *)(dp + n - sizeof (u_int16_t)));
+	if (last == 0x0e00) {
+		return 0;	/* big-endian node: do not convert it again */
+	}
+	if (last == 0x000e) {
+		return 1;	/* native node: convert it before writing */
+	}
+	return 0;		/* zeroed/unused node: leave it alone */
+}
