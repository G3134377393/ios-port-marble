+/* Panel memory + present accounting, for the dump header and console log. */
+extern "C" void
+sweet_fb_panel_info(uint64_t *phys, uint32_t *width, uint32_t *height, uint32_t *stride,
+    uint64_t *present_calls, uint64_t *layer_copies)
+{
+	AppleCLCD *fb = sweet_fb_instance;
+
+	if (phys != NULL) {
+		*phys = fb != NULL ? fb->fPhys : 0;
+	}
+	if (width != NULL) {
+		*width = fb != NULL ? fb->fWidth : 0;
+	}
+	if (height != NULL) {
+		*height = fb != NULL ? fb->fHeight : 0;
+	}
+	if (stride != NULL) {
+		*stride = fb != NULL ? fb->fRowBytes : 0;
+	}
+	if (present_calls != NULL) {
+		*present_calls = fb != NULL ? fb->fPresentCalls : 0;
+	}
+	if (layer_copies != NULL) {
+		*layer_copies = fb != NULL ? fb->fLayerCopies : 0;
+	}
+}
